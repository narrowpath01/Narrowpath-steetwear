generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- 1. INVENTORY MANAGEMENT ---
model Product {
  id          String   @id @default(cuid())
  title       String
  handle      String   @unique
  description String   @db.Text
  collection  String   @default("PRINTED") // e.g., "PRINTED" or "MONOCHROME"
  status      String   @default("ACTIVE")  // "ACTIVE", "DRAFT", "ARCHIVED"
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images        Image[]
  variants      Variant[]
  wishlistItems WishlistItem[]

  @@index([status, collection])
  @@index([createdAt])
  @@index([isFeatured])
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  title     String // e.g., "Small", "Medium"
  price     Float
  sku       String? @unique
  inventory Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([productId])
  @@index([inventory])
}

model Image {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// --- 2. AUTHENTICATION (NEXTAUTH) ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?   @unique
  role          String    @default("CUSTOMER") // "CUSTOMER" or "ADMIN"
  otpCode       String?
  otpExpires    DateTime?

  accounts  Account[]
  sessions  Session[]
  orders    Order[]
  addresses Address[]
  cart      Cart?
  wishlist  Wishlist?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- 3. USER DATA (ADDRESSES) ---
model Address {
  id          String   @id @default(cuid())
  userId      String
  firstName   String
  lastName    String
  email       String
  phoneNumber String?
  street      String   @db.Text
  city        String
  state       String
  pinCode     String
  country     String   @default("IN")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- 4. TRANSACTIONS & FULFILLMENT ---
model Order {
  id                String      @id @default(cuid())
  userId            String
  amount            Float
  status            String      @default("PENDING")
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?     @unique
  createdAt         DateTime    @default(now())
  deliveredAt       DateTime?   // CRITICAL: You need this to enforce the 3-day rule
  
  // Logistics Fields
  awb               String?     // Delhivery Tracking Number

  trackingNumber    String?     
  shippingStatus    String      @default("PENDING")
  addressId         String? // The ID of the address used for this order
  address           Address?    @relation(fields: [addressId], references: [id])
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  // Link to the return request
  returnRequest     ReturnRequest?

  @@index([userId])
  @@index([status, createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  variantId String
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

// --- 5. SERVER-SIDE CART ---
model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  guestId   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model ReturnRequest {
  id          String   @id @default(cuid())
  orderId     String   @unique
  reason      String   @db.Text
  type        String   // "REFUND" or "EXCHANGE"
  isDefective Boolean  @default(false) // Determines if they pay the 50% shipping fee
  mediaUrl    String   // URL to the unboxing video or clear photographs
  status      String   @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED
  adminNotes  String?  @db.Text
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

// --- 6. CATALOG EXTENSIONS ---
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- 7. EDITORIAL & BLOG CMS ---
model Blog {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String?   @db.Text
  content       String    @db.Text
  featuredImage String?
  category      String?   @default("Editorial")
  tags          String?
  status        String    @default("DRAFT") // "DRAFT", "PUBLISHED", "ARCHIVED"
  publishedAt   DateTime?
  authorName    String?   @default("Narrow Path Team")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, publishedAt])
}

// --- 8. ANNOUNCEMENTS & MARQUEE ---
model Announcement {
  id        String   @id @default(cuid())
  text      String
  link      String?
  isActive  Boolean  @default(true)
  priority  Int      @default(0)
  type      String   @default("MARQUEE") // "MARQUEE" or "BANNER"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, priority])
}

// --- 9. MARKETING & DISCOUNTS ---
model Promotion {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  discountType   String    @default("PERCENTAGE") // "PERCENTAGE" or "FIXED"
  discountValue  Float
  minOrderAmount Float?    @default(0)
  isActive       Boolean   @default(true)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive])
}

// --- 10. STORE CONFIGURATION ---
model StoreSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// --- 11. CUSTOM DESIGN STUDIO ---
model CustomDesign {
  id        String   @id @default(cuid())
  imageData String   @db.Text
  baseColor String
  size      String
  details   String?  @db.Text
  createdAt DateTime @default(now())
}